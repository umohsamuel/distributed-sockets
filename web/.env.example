# Comma-separated list of id=websocket-url. The first server is used by the
# person who starts a chat, the second by the person who joins.
VITE_SERVERS=server-1=ws://localhost:9001/ws,server-2=ws://localhost:9002/ws

# Production (behind deploy/nginx.conf):
# VITE_SERVERS=server-1=wss://sockets-api.umohsg.com/s1/ws,server-2=wss://sockets-api.umohsg.com/s2/ws

VITE_GITHUB_URL=https://github.com/umohsamuel/distributed-sockets
VITE_ARTICLE_URL=https://www.umohsg.com/blog/distributed-sockets-b54b91e0-adc1-4333-9190-66e28f7b7b19

# Public origin of this site, used for canonical/og:url/og:image, sitemap.xml and robots.txt
VITE_SITE_URL=https://sockets.umohsg.com
